PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/temple_connect?schema=public"

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# https://nominatim.org/release-docs/latest/api/Overview/ (no key required, set a real contact per usage policy)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=temple-connect-app (contact@example.com)

# Google Places API key: https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=

# Swiss Ephemeris service (self-hosted or third-party) base URL
SWISS_EPHEMERIS_BASE_URL=http://localhost:5001
