PORT=4000
NODE_ENV=development

# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Required in production: a random string of at least 32 characters
JWT_SECRET=change-this-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed by CORS (leave empty for mobile-only use)
CORS_ORIGINS=

# SMTP for password-reset emails. Without SMTP_HOST, emails are printed to the console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Temple Connect <no-reply@example.com>
# Development only: include the reset code in the forgot-password response
DEV_EXPOSE_RESET_CODE=false

# https://nominatim.org/release-docs/latest/api/Overview/ (no key required; set a real contact per usage policy)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=temple-connect-app (contact@example.com)

# Google Maps Platform key with Places API enabled (optional; improves search & nearby results)
GOOGLE_MAPS_API_KEY=

# Proxy hops to trust for client IPs (1 behind nginx/a load balancer, 0 when not behind a proxy)
TRUST_PROXY=0

# Google sign-in: comma-separated OAuth client IDs (Web, Android, iOS) from Google Cloud Console
GOOGLE_OAUTH_CLIENT_IDS=

# ── Temple features ──
# URL the mobile app uses to reach this API (used for the payment page and local image uploads)
PUBLIC_API_URL=http://10.0.2.2:4000
# Razorpay (https://dashboard.razorpay.com → Settings → API Keys). Use rzp_test_ keys for testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Settings → Webhooks, URL: <PUBLIC_API_URL>/api/payments/razorpay/webhook, events: payment.captured, payment.failed, refund.processed)
RAZORPAY_WEBHOOK_SECRET=
# Dev only: simulate payments when Razorpay keys are missing (ignored in production)
ALLOW_SIMULATED_PAYMENTS=true
# AWS S3 for event posters / images. If unset, images are stored on the API server's disk.
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: CloudFront or custom domain serving the bucket
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=uploads
