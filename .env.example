PORT=4000
NODE_ENV=development

# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Required in production: a random string of at least 32 characters
JWT_SECRET=change-this-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed by CORS (leave empty for mobile-only use)
CORS_ORIGINS=

# SMTP for password-reset emails. Without SMTP_HOST, emails are printed to the console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Temple Connect <no-reply@example.com>
# Development only: include the reset code in the forgot-password response
DEV_EXPOSE_RESET_CODE=false

# https://nominatim.org/release-docs/latest/api/Overview/ (no key required; set a real contact per usage policy)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=temple-connect-app (contact@example.com)

# Google Maps Platform key with Places API enabled (optional; improves search & nearby results)
GOOGLE_MAPS_API_KEY=

# Proxy hops to trust for client IPs (1 behind nginx/a load balancer, 0 when not behind a proxy)
TRUST_PROXY=0
