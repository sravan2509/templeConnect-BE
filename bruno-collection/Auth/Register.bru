meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Test User",
    "email": "test@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar("authToken", res.body.token);
  }
}
